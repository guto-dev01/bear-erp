# === Build Stage ===
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend-angular/package*.json ./
RUN npm ci --legacy-peer-deps

COPY frontend-angular/ .
RUN npm run build -- --configuration=production

# === Runtime Stage ===
FROM nginx:1.25-alpine

COPY infra/docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/dist/bear-erp/browser /usr/share/nginx/html

RUN addgroup -S bearerp && adduser -S bearerp -G bearerp && \
    chown -R bearerp:bearerp /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && chown bearerp:bearerp /var/run/nginx.pid

USER bearerp

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
